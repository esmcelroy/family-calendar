# Copy this file to .env and replace each generated value before starting Compose.
# Use: openssl rand -hex 32 for POSTGRES_PASSWORD and SESSION_SECRET
# Use: openssl rand -base64 32 for SMTP_ENCRYPTION_KEY
POSTGRES_DB=family_calendar
POSTGRES_USER=family_calendar
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SESSION_SECRET=replace-with-openssl-rand-hex-32
SMTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Public port; reverse proxies should set TRUST_PROXY=true only when configured.
APP_PORT=3000
TRUST_PROXY=false
